{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"rootDir": "src",
		"declaration": true,
		"declarationDir": "dist/types",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
